<?xml version="1.0" encoding="UTF-8"?>
<ehcache>

  <!-- Default cache -->
  <!-- Increased from 1M/6h to 5M/12h — revival of #20390's experiment -->
  <!--
    Ensure that default cache has less frequent expiration than query cache
    to avoid individual select queries per entity.
  -->

  <defaultCache
    maxElementsInMemory="5000000"
    eternal="false"
    timeToIdleSeconds="21600"
    timeToLiveSeconds="43200"
    memoryStoreEvictionPolicy="LRU"
    overflowToDisk="false"
    diskPersistent="false" />

  <!-- org.hisp.dhis.option.OptionSet / OptionSet.options / org.hisp.dhis.option.Option
       named regions removed (canary experiment): L2 cache dropped entirely for these three
       via their .hbm.xml mappings (see Option.hbm.xml for rationale + live evidence), so
       Hibernate never requests these regions and named config here would be dead. -->

  <!-- Hibernate query cache -->

  <cache name="org.hibernate.cache.internal.StandardQueryCache"
    maxElementsInMemory="5000000"
    eternal="false"
    timeToIdleSeconds="21600"
    timeToLiveSeconds="43200"
    memoryStoreEvictionPolicy="LRU"
    overflowToDisk="false"
    diskPersistent="false" />

  <cache name="org.hibernate.cache.spi.UpdateTimestampsCache"
    maxElementsInMemory="10000"
    eternal="true"
    memoryStoreEvictionPolicy="LRU"
    overflowToDisk="false"
    diskPersistent="false" />
</ehcache>
