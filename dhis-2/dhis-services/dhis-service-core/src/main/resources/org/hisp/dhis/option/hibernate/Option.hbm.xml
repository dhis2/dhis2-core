<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd"
  [<!ENTITY identifiableProperties SYSTEM "classpath://org/hisp/dhis/common/identifiableProperties.hbm">]
  >

<hibernate-mapping>
  <class name="org.hisp.dhis.option.Option" table="optionvalue" batch-size="100">

    <cache usage="read-write" />

    <!-- L2 cache re-enabled as read-write, not removed (canary experiment, revised): originally
         removed entirely (see git history) after live evidence that tracker preheat's
         query-driven bulk loads unconditionally re-put every row on every fetch, contending on
         Ehcache's per-key lock under concurrent imports (put:get ratio climbing from ~0.06 to
         ~0.19 under load). Root cause turned out to be strategy-specific, not caching-in-general:
         confirmed by decompiling the actual Hibernate 5.6.15 jar in use,
         NONSTRICT_READ_WRITE's putFromLoad (AbstractCachedDomainDataAccess) always puts
         unconditionally, but READ_WRITE's putFromLoad (AbstractReadWriteAccess) skips the put
         entirely when the item is already cache-resident, for any non-versioned entity (no
         Hibernate <version> column, true here). Option is confirmed never written in this
         workload, and only rarely written at all (admin edits), so READ_WRITE's soft-lock
         forced-miss downside (which only engages on a concurrent write) costs almost nothing,
         while its put-skip recovers exactly the redundant-put/contention mechanism that
         motivated removing caching entirely. This should restore Option's ~99.97%-hit-ratio
         free keyed-lookup benefit (lost entirely while uncached) without reintroducing the
         concurrency-scaling put cost. batch-size="100" (added while uncached, to fold the
         resulting ~9,000 individual session.get() calls per request into WHERE id IN (...)
         batches) is left in place as a defense-in-depth for cold-cache/eviction bursts; expected
         to matter far less now that the cache is warm most of the time again. -->

    <id name="id" column="optionvalueid">
      <generator class="native" />
    </id>

    <property name="uid" column="uid" unique="true" length="11" not-null="true" />

    <property name="code" column="code" not-null="true" unique="false" length="230" />

    <property name="name" column="name" not-null="true" length="230" />

    <property name="created" type="timestamp" not-null="true" />

    <property name="lastUpdated" type="timestamp" not-null="true" />

    <property name="sortOrder" column="sort_order" />

    <property name="description" type="text" />

    <property name="formName" type="text" />

    <property name="style" type="jbObjectStyle" column="style" />

    <property name="translations" type="jblTranslations"/>

    <many-to-one name="optionSet" class="org.hisp.dhis.option.OptionSet" column="optionsetid" />

    <!-- Dynamic attribute values -->
    <property name="attributeValues" type="jsbAttributeValues"/>

  </class>

</hibernate-mapping>
