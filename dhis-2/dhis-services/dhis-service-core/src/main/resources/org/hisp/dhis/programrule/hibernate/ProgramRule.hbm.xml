<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd"
  [<!ENTITY identifiableProperties SYSTEM "classpath://org/hisp/dhis/common/identifiableProperties.hbm">]
  >

<hibernate-mapping>
  <class name="org.hisp.dhis.programrule.ProgramRule" table="programrule">

    <!-- read-write, not nonstrict-read-write (canary experiment): ProgramRule is non-versioned
         and effectively static relative to data-entry traffic (rarely written concurrently with
         reads). Live-traced: getProgramRulesByActionTypes()'s JOIN pr.programRuleActions query
         runs on every event/enrollment validation, redundantly re-loading the same rows every
         time. Under NONSTRICT_READ_WRITE (AbstractCachedDomainDataAccess.putFromLoad),
         every load unconditionally re-puts, no check at all. Under READ_WRITE
         (AbstractReadWriteAccess.putFromLoad), a non-versioned entity that's already
         cache-resident makes Item.isWriteable() return false, skipping the put entirely,
         confirmed by decompiling the actual Hibernate 5.6.15 jar in use. The soft-lock
         forced-miss downside of READ_WRITE only engages on a concurrent write, which is rare
         here, so this trades away little to get the skip-redundant-put behavior back. -->

    <cache usage="read-write" />

    <id name="id" column="programruleid">
      <generator class="native" />
    </id>
    &identifiableProperties;

    <property name="name" column="name" not-null="true" length="230" />

    <property name="description" />

    <property name="translations" type="jblTranslations"/>

    <many-to-one name="program" class="org.hisp.dhis.program.Program"
      column="programid" foreign-key="fk_programrule_program" not-null="true" />

    <many-to-one name="programStage" class="org.hisp.dhis.program.ProgramStage"
      column="programstageid" foreign-key="fk_programrule_programstage" />

    <set name="programRuleActions" cascade="all-delete-orphan">
      <!-- read-write, same rationale as the class-level cache above: CollectionReadWriteAccess
           shares AbstractReadWriteAccess's skip-redundant-put behavior; CollectionNonStrictReadWriteAccess
           does not. -->
      <cache usage="read-write"/>
      <key column="programruleid" />
      <one-to-many class="org.hisp.dhis.programrule.ProgramRuleAction" />
    </set>

    <property name="condition" column="rulecondition" type="text" not-null="false" />

    <property name="priority" />

  </class>

</hibernate-mapping>
